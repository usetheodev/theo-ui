{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "scripts/**",
        "tsup.config.ts",
        "tsconfig.json",
        "tsconfig.dts.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        ".ladle/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "vitest.config.ts",
        "package.json"
      ],
      "outputs": []
    },
    "lint": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "biome.json",
        "package.json"
      ],
      "outputs": []
    }
  }
}
