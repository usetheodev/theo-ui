{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/components/primitives/*/index.ts",
    "src/components/composites/*/index.ts",
    "src/components/primitives/slide/plugins/*/index.ts",
    "scripts/**/*.ts",
    "scripts/**/*.sh",
    "playground/**/*.{ts,tsx}",
    ".ladle/**/*.{ts,tsx}",
    "src/test/**/*.{ts,tsx}",
    "src/**/*.test.{ts,tsx}",
    "src/**/*.stories.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "playground/**/*.{ts,tsx}", ".ladle/**/*.{ts,tsx}"],
  "ignore": [
    "tests/fixture-shadcn-app/**",
    "referencia/**",
    "skills/**",
    "_site/**",
    "src/components/primitives/whiteboard/schema.ts",
    "src/components/primitives/slide/schema.ts",
    "src/components/primitives/whiteboard/render/rough-paths.ts",
    "src/lib/markdown/mermaid.tsx"
  ],
  "ignoreDependencies": [
    "@parcel/watcher",
    "katex",
    "mermaid",
    "shiki",
    "geist",
    "@tailwindcss/cli",
    "@theokit/plugin-canvas"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "warn",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "error"
  }
}
